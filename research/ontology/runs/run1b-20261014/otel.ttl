    ops:placedOn sut:host-fb14srv6 .

sut:ctr-quoteservice a ops:Container ;
    ops:placedOn sut:host-fb14srv6 .

sut:ctr-recommendationservice a ops:Container ;
    ops:placedOn sut:host-fb14srv6 .

sut:ctr-shippingservice a ops:Container ;
    ops:placedOn sut:host-fb14srv6 .

sut:ctr-valkey-cart a ops:Container ;
    ops:placedOn sut:host-fb14srv6 .

sut:svc-quoteservice a omsac:Microservice ;
    ops:runsIn sut:ctr-quoteservice .

sut:topic-orders a ops:Topic ;
    ops:onBroker sut:svc-kafka .

sut:svc-accountingservice a omsac:Microservice ;
    ops:consumesFrom sut:topic-orders ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:memberOf sut:group-accountingservice ;
    ops:runsIn sut:ctr-accountingservice .

sut:svc-emailservice a omsac:Microservice ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-emailservice .

sut:svc-flagd-ui a omsac:Microservice ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-flagd-ui .

sut:svc-kafka a ops:Broker ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-kafka .

sut:svc-adservice a omsac:Microservice ;
    ops:callsSync sut:svc-flagd ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-adservice .

sut:svc-frauddetectionservice a omsac:Microservice ;
    ops:callsSync sut:svc-flagd ;
    ops:consumesFrom sut:topic-orders ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:memberOf sut:group-frauddetectionservice ;
    ops:runsIn sut:ctr-frauddetectionservice .

sut:svc-imageprovider a omsac:Microservice ;
    ops:emits sut:sensor-imageprovider ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-imageprovider .

sut:svc-valkey-cart a omsac:Cache ;
    ops:runsIn sut:ctr-valkey-cart .

sut:svc-currencyservice a omsac:Microservice ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-currencyservice .

sut:svc-loadgenerator a omsac:Microservice ;
    ops:callsSync sut:svc-flagd,
        sut:svc-frontendproxy ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-loadgenerator .

sut:svc-recommendationservice a omsac:Microservice ;
    ops:callsSync sut:svc-flagd,
        sut:svc-productcatalogservice ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-recommendationservice .

sut:svc-grafana a omsac:Technology ;
    ops:callsSync sut:svc-jaeger,
        sut:svc-opensearch,
        sut:svc-prometheus ;
    ops:exportsTelemetryTo sut:svc-stats.grafana.org ;
    ops:runsIn sut:ctr-grafana .

sut:svc-opensearch a omsac:Technology ;
    ops:runsIn sut:ctr-opensearch .

sut:svc-shippingservice a omsac:Microservice ;
    ops:callsSync sut:svc-quoteservice ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-shippingservice .

sut:svc-cartservice a omsac:Microservice ;
    ops:callsSync sut:svc-flagd,
        sut:svc-valkey-cart ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-cartservice .

sut:svc-paymentservice a omsac:Microservice ;
    ops:callsSync sut:svc-flagd ;
    ops:emits <http://obsplacement.example/sut/otel#sensor-Charge_request_received.>,
        <http://obsplacement.example/sut/otel#sensor-Transaction_complete.>,
        sut:sensor-app.payment.transactions,
        sut:sensor-charge ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-paymentservice .

sut:svc-productcatalogservice a omsac:Microservice ;
    ops:callsSync sut:svc-flagd ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-productcatalogservice .

sut:svc-jaeger a omsac:Technology ;
    ops:callsSync sut:svc-prometheus ;
    ops:runsIn sut:ctr-jaeger .

sut:svc-prometheus a omsac:Technology ;
    ops:callsSync sut:svc-otelcol ;
    ops:runsIn sut:ctr-prometheus .

sut:svc-checkoutservice a omsac:Microservice ;
    ops:callsSync sut:svc-cartservice,
        sut:svc-currencyservice,
        sut:svc-emailservice,
        sut:svc-paymentservice,
        sut:svc-productcatalogservice,
        sut:svc-shippingservice ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:publishesTo sut:topic-orders ;
    ops:runsIn sut:ctr-checkoutservice .

sut:svc-frontend a omsac:Microservice ;
    ops:callsSync sut:svc-adservice,
        sut:svc-cartservice,
        sut:svc-checkoutservice,
        sut:svc-currencyservice,
        sut:svc-productcatalogservice,
        sut:svc-recommendationservice,
        sut:svc-shippingservice ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-frontend .

sut:svc-frontendproxy a omsac:Microservice ;
    ops:callsSync sut:svc-flagd,
        sut:svc-flagd-ui,
        sut:svc-frontend,
        sut:svc-grafana,
        sut:svc-imageprovider,
        sut:svc-jaeger,
        sut:svc-loadgenerator,
        sut:svc-otelcol ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-frontendproxy .

sut:svc-flagd a omsac:Technology ;
    ops:exportsTelemetryTo sut:svc-otelcol ;
    ops:runsIn sut:ctr-flagd .

sut:arch-otel a omsac:MicroserviceArchitecture ;
    omsac:isComposedOf sut:svc-accountingservice,
        sut:svc-adservice,
        sut:svc-cartservice,
        sut:svc-checkoutservice,
        sut:svc-currencyservice,
        sut:svc-emailservice,
        sut:svc-flagd,
        sut:svc-flagd-ui,
        sut:svc-frauddetectionservice,
        sut:svc-frontend,
        sut:svc-frontendproxy,
        sut:svc-grafana,
        sut:svc-imageprovider,
        sut:svc-jaeger,
        sut:svc-kafka,
        sut:svc-loadgenerator,
        sut:svc-opensearch,
        sut:svc-otelcol,
        sut:svc-paymentservice,
        sut:svc-productcatalogservice,
        sut:svc-prometheus,
        sut:svc-quoteservice,
        sut:svc-recommendationservice,
        sut:svc-shippingservice,
        sut:svc-valkey-cart .

sut:host-fb14srv6 a ops:Host .

sut:svc-otelcol a ops:Collector ;
    ops:callsSync sut:svc-frontendproxy,
        sut:svc-jaeger,
        sut:svc-opensearch,
        sut:svc-prometheus,
        sut:svc-valkey-cart ;
    ops:exportsTelemetryTo sut:svc-jaeger,
        sut:svc-opensearch,
        sut:svc-prometheus ;
    ops:runsIn sut:ctr-otelcol .

