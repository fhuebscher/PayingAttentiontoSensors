sut:svc-geo a omsac:Microservice ;
    ops:emits sut:sensor-otgrpc_server_interceptor_gRPC_server_spans_,
        sut:sensor-zerolog_console_writer_to_stdout ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-geo .

sut:svc-rate a omsac:Microservice ;
    ops:callsSync sut:svc-memcached-rate,
        sut:svc-mongodb-rate ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-rate .

sut:svc-recommendation a omsac:Microservice ;
    ops:emits sut:sensor-otgrpc_server_interceptor_gRPC_unary_server_spans,
        sut:sensor-zerolog_console_writer_to_stdout ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-recommendation .

sut:svc-user a omsac:Microservice ;
    ops:callsSync sut:svc-mongodb-user ;
    ops:emits sut:sensor-zerolog ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-user .

sut:svc-reservation a omsac:Microservice ;
    ops:callsSync sut:svc-consul,
        sut:svc-memcached-reserve,
        sut:svc-mongodb-reservation ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-reservation .

sut:svc-frontend a omsac:Microservice ;
    ops:callsSync sut:svc-attractions,
        sut:svc-profile,
        sut:svc-recommendation,
        sut:svc-reservation,
        sut:svc-review,
        sut:svc-search,
        sut:svc-user ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:runsIn sut:ctr-frontend .

sut:svc-review a omsac:Microservice ;
    ops:callsSync sut:svc-consul,
        sut:svc-memcached-review,
        sut:svc-mongodb-review ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-review .

sut:svc-search a omsac:Microservice ;
    ops:callsSync sut:svc-geo,
        sut:svc-rate,
        sut:svc-srv-geo,
        sut:svc-srv-rate ;
    ops:exportsTelemetryTo sut:svc-jaeger,
        sut:svc-stdout ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-search .

sut:svc-profile a omsac:Microservice ;
    ops:callsSync sut:svc-memcached-profile,
        sut:svc-mongodb-profile ;
    ops:emits sut:sensor-memcached_get_profile,
        sut:sensor-mongo_profile ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-profile .

sut:svc-attractions a omsac:Microservice ;
    ops:callsSync sut:svc-mongodb-attractions ;
    ops:emits sut:sensor-mongo_cinema,
        sut:sensor-mongo_museum,
        sut:sensor-mongo_restaurant,
        sut:sensor-otgrpc.OpenTracingServerInterceptor,
        sut:sensor-stdout ;
    ops:exportsTelemetryTo sut:svc-jaeger ;
    ops:registersWith sut:coord-consul ;
    ops:runsIn sut:ctr-attractions .

sut:arch-hotel a omsac:MicroserviceArchitecture ;
    omsac:isComposedOf sut:svc-attractions,
