sut:arch-otel a omsac:MicroserviceArchitecture ;
    omsac:isComposedOf sut:svc-accountingservice .

sut:host-fb14srv6 a ops:Host .

sut:rs-accountingservice a ops:ReplicaSet ;
    ops:replicaCount "1"^^xsd:nonNegativeInteger ;
    ops:replicaSetOf sut:svc-accountingservice .

sut:ctr-accounting-service a ops:Container ;
    ops:placedOn sut:host-fb14srv6 .

sut:svc-accountingservice a omsac:Microservice ;
    ops:callsSync sut:svc-kafka,
        sut:svc-otelcol ;
    ops:runsIn sut:ctr-accounting-service .

