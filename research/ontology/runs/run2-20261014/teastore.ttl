sut:rs-auth a ops:ReplicaSet ;
    ops:replicaCount "1"^^xsd:nonNegativeInteger ;
    ops:replicaSetOf sut:svc-auth .

sut:rs-db a ops:ReplicaSet ;
    ops:replicaCount "1"^^xsd:nonNegativeInteger ;
    ops:replicaSetOf sut:svc-db .

sut:rs-image a ops:ReplicaSet ;
    ops:replicaCount "1"^^xsd:nonNegativeInteger ;
    ops:replicaSetOf sut:svc-image .

sut:rs-persistence a ops:ReplicaSet ;
    ops:replicaCount "1"^^xsd:nonNegativeInteger ;
    ops:replicaSetOf sut:svc-persistence .

sut:rs-recommender a ops:ReplicaSet ;
    ops:replicaCount "1"^^xsd:nonNegativeInteger ;
    ops:replicaSetOf sut:svc-recommender .

sut:rs-registry a ops:ReplicaSet ;
    ops:replicaCount "1"^^xsd:nonNegativeInteger ;
    ops:replicaSetOf sut:svc-registry .

sut:rs-webui a ops:ReplicaSet ;
    ops:replicaCount "1"^^xsd:nonNegativeInteger ;
    ops:replicaSetOf sut:svc-webui .

sut:ctr-db a ops:Container ;
    ops:placedOn sut:host-fb14srv5 .

sut:ctr-descartesresearch_teastore-auth a ops:Container ;
    ops:placedOn sut:host-fb14srv5 .

sut:ctr-descartesresearch_teastore-image a ops:Container ;
    ops:placedOn sut:host-fb14srv5 .

sut:ctr-persistence a ops:Container ;
    ops:placedOn sut:host-fb14srv5 .

sut:ctr-recommender a ops:Container ;
    ops:placedOn sut:host-fb14srv5 .

sut:ctr-registry a ops:Container ;
    ops:placedOn sut:host-fb14srv5 .

sut:ctr-webui a ops:Container ;
    ops:placedOn sut:host-fb14srv5 .

sut:arch-teastore a omsac:MicroserviceArchitecture ;
    omsac:isComposedOf sut:svc-auth,
        sut:svc-db,
        sut:svc-image,
        sut:svc-persistence,
        sut:svc-recommender,
        sut:svc-registry,
        sut:svc-webui .

sut:svc-db a omsac:Database ;
    ops:runsIn sut:ctr-db .

sut:live-registry_registry-heartbeat-0 a ops:LivenessMechanism ;
    ops:enforcedBy sut:coord-registry_registry-heartbeat ;
    ops:failureTimeoutSeconds 10.0 ;
    ops:healthCheckConfigured false ;
    ops:heartbeatIntervalSeconds 2.5 ;
    ops:heartbeatThreadIndependentOfWork true ;
    ops:monitors sut:svc-auth,
        sut:svc-image,
        sut:svc-persistence,
        sut:svc-recommender,
        sut:svc-webui .

sut:svc-auth a omsac:Microservice ;
    ops:callsSync sut:svc-persistence ;
    ops:exportsTelemetryTo sut:svc-rabbitmq ;
    ops:registersWith sut:coord-registry_registry-heartbeat ;
    ops:runsIn sut:ctr-descartesresearch_teastore-auth .

sut:coord-registry_registry-heartbeat a ops:ServiceRegistry ;
    ops:hostedBy sut:svc-registry .

sut:svc-image a omsac:Microservice ;
    ops:callsSync sut:svc-persistence,
        sut:svc-registry ;
    ops:exportsTelemetryTo sut:svc-rabbitmq ;
    ops:registersWith sut:coord-registry_registry-heartbeat ;
    ops:runsIn sut:ctr-descartesresearch_teastore-image .

sut:host-fb14srv5 a ops:Host .

sut:svc-webui a omsac:Microservice ;
    ops:callsSync sut:svc-auth,
        sut:svc-image,
        sut:svc-persistence,
        sut:svc-recommender,
        sut:svc-registry ;
    ops:exportsTelemetryTo sut:svc-rabbitmq ;
    ops:registersWith sut:coord-registry_registry-heartbeat ;
    ops:runsIn sut:ctr-webui .

sut:svc-registry a omsac:Microservice ;
    ops:runsIn sut:ctr-registry .

sut:svc-recommender a omsac:Microservice ;
    ops:callsSync sut:svc-persistence,
        sut:svc-recommender,
        sut:svc-registry ;
    ops:exportsTelemetryTo sut:svc-rabbitmq ;
    ops:registersWith sut:coord-registry_registry-heartbeat ;
    ops:runsIn sut:ctr-recommender .

sut:svc-persistence a omsac:Microservice ;
    ops:callsSync sut:svc-db,
        sut:svc-persistence,
        sut:svc-registry ;
    ops:exportsTelemetryTo sut:svc-rabbitmq ;
    ops:registersWith sut:coord-registry_registry-heartbeat ;
    ops:runsIn sut:ctr-persistence .

