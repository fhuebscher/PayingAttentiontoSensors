diff --git a/hotelReservation/tracing/tracer.go b/hotelReservation/tracing/tracer.go
index 97fe22e..f96fcfa 100644
--- a/hotelReservation/tracing/tracer.go
+++ b/hotelReservation/tracing/tracer.go
@@ -3,0 +4,3 @@ import (
+	"context"
+	"encoding/json"
+	"fmt"
@@ -9,0 +13 @@ import (
+	jaeger "github.com/uber/jaeger-client-go"
@@ -10,0 +15 @@ import (
+	"github.com/uber/jaeger-client-go/thrift"
@@ -12,0 +18,35 @@ import (
+type countingTransport struct {
+	service  string
+	delegate jaeger.Transport
+}
+
+func (t *countingTransport) Append(span *jaeger.Span) (int, error) {
+	buffer := thrift.NewTMemoryBufferLen(65535)
+	protocol := thrift.NewTCompactProtocolFactory().GetProtocol(buffer)
+	serialized := jaeger.BuildJaegerThrift(span)
+	if err := serialized.Write(context.Background(), protocol); err != nil {
+		return 0, err
+	}
+	ctx := span.SpanContext()
+	row, _ := json.Marshal(map[string]interface{}{
+		"schema":                 "hotel-source-emitted-span-v1",
+		"service":                t.service,
+		"traceId":                ctx.TraceID().String(),
+		"spanId":                 ctx.SpanID().String(),
+		"startedAtUnixNano":      span.StartTime().UnixNano(),
+		"endedAtUnixNano":        span.StartTime().Add(span.Duration()).UnixNano(),
+		"compactThriftSpanBytes": buffer.Len(),
+		"wireBytes":              false,
+	})
+	fmt.Printf("OBSPLACEMENT_EMISSION %s\n", row)
+	return t.delegate.Append(span)
+}
+
+func (t *countingTransport) Flush() (int, error) {
+	return t.delegate.Flush()
+}
+
+func (t *countingTransport) Close() error {
+	return t.delegate.Close()
+}
+
