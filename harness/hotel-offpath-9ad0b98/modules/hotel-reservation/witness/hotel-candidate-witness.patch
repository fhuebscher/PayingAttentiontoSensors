+			"statusCode":        recorder.status,
+			"startedAtUnixNano": started.UnixNano(),
+			"endedAtUnixNano":   ended.UnixNano(),
+		})
+		fmt.Printf("OBSPLACEMENT_WITNESS %s\n", row)
+	})
