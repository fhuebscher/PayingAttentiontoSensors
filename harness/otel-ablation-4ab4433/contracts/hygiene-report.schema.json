{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/obsplacement/hygiene-report.schema.json",
  "title": "Server hygiene report",
  "type": "object",
  "required": ["schemaVersion", "target", "capturedAt", "policy", "inventory", "classifications", "verdict"],
  "properties": {
    "schemaVersion": {"const": 1},
    "target": {"type": "string"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "policy": {"type": "object"},
    "inventory": {"type": "object"},
    "classifications": {"type": "array", "items": {"type": "object"}},
    "verdict": {"enum": ["pass", "blocked", "inventory-error"]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
