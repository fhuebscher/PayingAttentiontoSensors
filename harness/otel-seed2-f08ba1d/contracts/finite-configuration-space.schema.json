{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observability-placement.local/contracts/finite-configuration-space.schema.json",
  "title": "Pinned finite catalog-admissible structural assignment spaces",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "status", "spaces", "claimBoundary"],
  "properties": {
    "$schema": {"const": "https://observability-placement.local/contracts/finite-configuration-space.schema.json"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "status": {"const": "frozen-for-exact-structural-enumeration"},
    "spaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/space"}},
    "claimBoundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "left", "right"],
      "properties": {
        "kind": {"enum": ["requires", "mutex"]},
        "left": {"type": "string", "minLength": 1},
        "right": {"type": "string", "minLength": 1}
      }
    },
    "space": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "module", "applicationFamily", "catalogBinding", "decisionGroups",
        "fixedAssignments", "constraints", "evidenceByGroup", "goalBindings"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "module": {"type": "string", "minLength": 1},
        "applicationFamily": {"type": "string", "minLength": 1},
        "catalogBinding": {"$ref": "#/$defs/binding"},
        "decisionGroups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fixedAssignments": {
          "type": "object", "additionalProperties": {"type": "boolean"}
        },
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
        "evidenceByGroup": {
          "type": "object",
          "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "goalBindings": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/binding"}}
      }
    }
  }
}
