{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observability-placement.invalid/schemas/teastore-patched-image-lock-v1.json",
  "title": "TeaStore patched image lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "inputContractSha256",
    "platform",
    "sourceCommit",
    "patchSha256",
    "registryClientSha256",
    "services"
  ],
  "properties": {
    "schema": {
      "const": "teastore.patched-image-lock"
    },
    "schemaVersion": {
      "const": 1
    },
    "inputContractSha256": {
      "$ref": "#/$defs/sha256"
    },
    "platform": {
      "const": "linux/amd64"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "patchSha256": {
      "$ref": "#/$defs/sha256"
    },
    "registryClientSha256": {
      "$ref": "#/$defs/sha256"
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth",
        "persistence",
        "webui"
      ],
      "properties": {
        "auth": {
          "$ref": "#/$defs/service"
        },
        "persistence": {
          "$ref": "#/$defs/service"
        },
        "webui": {
          "$ref": "#/$defs/service"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentImage",
        "artifactSha256",
        "dockerfileSha256",
        "outputImage",
        "imageId",
        "platform",
        "overlayPath"
      ],
      "properties": {
        "parentImage": {
          "$ref": "#/$defs/repositoryDigest"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dockerfileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outputImage": {
          "$ref": "#/$defs/repositoryDigest"
        },
        "imageId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "const": "linux/amd64"
        },
        "overlayPath": {
          "type": "string",
          "pattern": "^/usr/local/tomcat/webapps/tools\\.descartes\\.teastore\\.(auth|persistence|webui)\\.war$"
        }
      }
    },
    "repositoryDigest": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"
    }
  }
}
