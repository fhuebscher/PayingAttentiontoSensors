+package tools.descartes.teastore.registryclient.observability;
+
+import java.time.Instant;
+import java.util.regex.Pattern;
+
+import org.slf4j.Logger;
+
+/**
+ * Validates and emits the opaque correlation witness used by controlled
+ * observability experiments. This class deliberately never accepts or logs
+ * arbitrary headers, credentials, request bodies, or session data.
+ */
+public final class ObservabilityJourney {
+  public static final String HEADER = "X-Observability-Journey-Id";
+  public static final String LOG_PREFIX = "OBSERVABILITY_APP_WITNESS ";
+  private static final Pattern TOKEN = Pattern.compile("journey-[0-9a-f]{32}");
+
+  private ObservabilityJourney() {
+  }
+
+  /** Return the token when it has the generated workload shape, otherwise null. */
+  public static String validToken(String value) {
+    return value != null && TOKEN.matcher(value).matches() ? value : null;
+  }
+
+  /** Emit one fixed-schema, privacy-safe witness row for a valid token. */
+  public static void emit(Logger logger, String service, String event, String value) {
+    String token = validToken(value);
+    boolean fixedEvent = ("auth".equals(service) && "login-persistence-request".equals(event))
+        || ("persistence".equals(service) && "login-user-lookup".equals(event));
+    if (token == null || !fixedEvent) {
+      return;
+    }
+    logger.info(LOG_PREFIX
+        + "{\"schema\":\"teastore.app-witness-observation\",\"schemaVersion\":1,"
+        + "\"observedAtUtc\":\"" + Instant.now().toString() + "\","
+        + "\"journeyId\":\"" + token + "\","
+        + "\"service\":\"" + service + "\","
+        + "\"event\":\"" + event + "\"}");
+  }
+}
